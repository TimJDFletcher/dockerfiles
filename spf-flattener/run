#!/bin/bash
set -eu -o pipefail

CONTAINER_NAME=spf-flattener
IMAGE_NAME=timjdfletcher/${CONTAINER_NAME}
IMAGE_TAG=tmp
PLATFORMS="linux/amd64 linux/arm64"
SPF_FLATTENER_VERSION="main"

log() {
  echo "==> $*"
}

build() {
  log "Building ${IMAGE_NAME}:${IMAGE_TAG}"
  container build \
    --tag "${IMAGE_NAME}:${IMAGE_TAG}" \
    --build-arg GO_VERSION=1.24 \
    --build-arg SPF_FLATTENER_VERSION="${SPF_FLATTENER_VERSION}" \
    .
}

test() {
  build

  log "Testing container image..."

  # Test help output
  log "Test: help flag works"
  local help_output
  help_output=$(container run --rm "${IMAGE_NAME}:${IMAGE_TAG}" --help 2>&1 || true)
  if echo "${help_output}" | grep -q "domain"; then
    echo "  PASS"
  else
    echo "  FAIL: help output missing expected content"
    echo "  Output: ${help_output}"
    exit 1
  fi

  # Test all expected flags are present
  log "Test: all flags documented"
  for flag in domain initialSPF dryrun warn url authEmail authKey; do
    if echo "${help_output}" | grep -q "${flag}"; then
      echo "  PASS: --${flag}"
    else
      echo "  FAIL: missing --${flag} flag"
      exit 1
    fi
  done

  # Test DNS-based SPF flattening (works with Apple container CLI)
  log "Test: SPF flattening with real domain"
  local spf_output
  spf_output=$(container run --rm "${IMAGE_NAME}:${IMAGE_TAG}" \
    --domain gmail.com --dryrun=true --warn=false 2>&1)
  if echo "${spf_output}" | grep -q "Successfully flattened"; then
    echo "  PASS: gmail.com flattened successfully"
  else
    echo "  FAIL: SPF flattening failed"
    echo "  Output: ${spf_output}"
    exit 1
  fi

  log "All tests passed!"
}

clean() {
  log "Cleaning up..."
  container image rm "${IMAGE_NAME}:${IMAGE_TAG}" 2>/dev/null || true
  container image rm "${IMAGE_NAME}:latest" 2>/dev/null || true
}

release() {
  test

  if ! CURRENT_TAG=$(git describe --tags --exact-match 2>/dev/null); then
    log "Error: Current commit is not tagged."
    log "Tag with: git tag ${CONTAINER_NAME}-v<VERSION>"
    exit 1
  fi

  log "Releasing ${CURRENT_TAG}"
  
  # Build multi-arch image
  local platform_args=""
  for platform in ${PLATFORMS}; do
    platform_args="${platform_args} --platform ${platform}"
  done
  
  # shellcheck disable=SC2086
  container build \
    ${platform_args} \
    --tag "${IMAGE_NAME}:${CURRENT_TAG#${CONTAINER_NAME}-}" \
    --build-arg GO_VERSION=1.24 \
    --build-arg SPF_FLATTENER_VERSION="${SPF_FLATTENER_VERSION}" \
    .

  log "Multi-arch build complete: ${IMAGE_NAME}:${CURRENT_TAG#${CONTAINER_NAME}-}"
  log ""
  log "Note: Push to registry manually with:"
  log "  container push ${IMAGE_NAME}:${CURRENT_TAG#${CONTAINER_NAME}-}"
}

usage() {
  cat <<EOF
Usage: ./run [COMMAND]

Commands:
  build    Build local image (${IMAGE_NAME}:${IMAGE_TAG})
  test     Build and run validation tests (including DNS tests)
  clean    Remove images
  release  Test, build multi-arch (push manually)

Note: Uses Apple's native container CLI for proper DNS resolution.
EOF
}

CMD=${1:-}
shift || true

case ${CMD} in
  build)   build ;;
  test)    test ;;
  clean)   clean ;;
  release) release ;;
  *)       usage ;;
esac
