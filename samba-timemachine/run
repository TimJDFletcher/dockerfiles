#!/bin/bash
set -eu -o pipefail

IMAGE_NAME="timjdfletcher/samba-timemachine"
GOSS_IMAGE="timjdfletcher/goss"
# Default to 'tmp' if not running a release
IMAGE_TAG="${IMAGE_TAG:-tmp}"
PLATFORMS="linux/amd64,linux/arm64"
TESTHOST="carbon"
GOSS_DST="/goss"
CONTAINER_NAME="samba-timemachine"
# promtool, used by the tests to parse the metrics file; pinned by tag and index digest
PROMTOOL_IMAGE="quay.io/prometheus/prometheus:v3.15.0@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- Helper Functions ---

log() {
  echo "[$(date +'%H:%M:%S')] $1"
}

_ensure_goss_image() {
  if ! docker image inspect "${GOSS_IMAGE}:${IMAGE_TAG}" >/dev/null 2>&1; then
    log "Goss image not found, building..."
    (cd "${SCRIPT_DIR}/../goss" && ./run build)
  fi
}

# Determine date command for macOS (BSD) vs Linux (GNU) compatibility
get_start_date() {
  if date --version >/dev/null 2>&1; then
    date -d '12 hours ago' +'%Y-%m-%d %H:%M:%S' # Linux
  else
    date -j -v-12H +'%Y-%m-%d %H:%M:%S' # macOS
  fi
}

wait_for_health() {
  log "Waiting for container to become healthy..."
  for _ in {1..30}; do
    if docker compose ps --format json | grep -q '"Health":"healthy"'; then
      log "Container is healthy!"
      return 0
    fi
    sleep 1
  done
  log "Timeout waiting for container health."
  return 1
}

# --- Core Tasks ---

build() {
  _ensure_goss_image
  log "Building local image: ${IMAGE_NAME}:${IMAGE_TAG}"
  # Use docker build (not buildx) for local builds so it can access local goss image
  docker build \
    --build-arg GOSS_IMAGE="${GOSS_IMAGE}:${IMAGE_TAG}" \
    --tag "${IMAGE_NAME}:${IMAGE_TAG}" \
    --file Dockerfile .
  docker tag "${IMAGE_NAME}:${IMAGE_TAG}" "${IMAGE_NAME}:latest"
}

clean() {
  log "Cleaning up..."
  docker compose down --volumes --remove-orphans || true
  docker image rm "${IMAGE_NAME}:${IMAGE_TAG}" "${IMAGE_NAME}:latest" 2>/dev/null || true
  docker buildx prune --force --filter "until=24h"
}

_up() {
  build
  log "Starting environment..."
  docker compose up --remove-orphans --detach
}

_down() {
  docker compose down --remove-orphans
}

_exec() {
  # Ensure we are up before exec
  if [ -z "$(docker compose ps -q)" ]; then
    log "Container not running. Starting up..."
    _up
  fi
  docker compose exec "${CONTAINER_NAME}" /bin/bash
}

# Print the value of a metric from the container's METRICS_FILE (empty if absent)
_metric_value() {
  docker compose exec -T "${CONTAINER_NAME}" cat "${METRICS_FILE}" |
    awk -v name="$1" '$1 == name { print $2 }'
}

# Fail unless the container's METRICS_FILE parses as Prometheus text format
_check_metrics_format() {
  log "Checking metrics format with promtool ($1)..."
  docker compose exec -T "${CONTAINER_NAME}" cat "${METRICS_FILE}" |
    docker run --rm -i --entrypoint promtool "${PROMTOOL_IMAGE}" check metrics
}

# Fail unless every timemachine_* metric the Grafana dashboard queries is in the container's METRICS_FILE
_check_dashboard_metrics() {
  local dashboard="${SCRIPT_DIR}/grafana/timemachine-dashboard.json" queried metrics metric missing=0
  log "Checking the dashboard only queries metrics the container writes..."
  queried=$(grep -o 'timemachine_[a-z_]*' "${dashboard}" | sort -u)
  if [ -z "${queried}" ]; then
    log "FAIL: no timemachine_* metrics found in ${dashboard}"
    return 1
  fi
  metrics=$(docker compose exec -T "${CONTAINER_NAME}" cat "${METRICS_FILE}")
  for metric in ${queried}; do
    if ! grep -q "^${metric}[{ ]" <<< "${metrics}"; then
      log "FAIL: dashboard queries ${metric}, which the metrics file doesn't contain"
      missing=1
    fi
  done
  return "${missing}"
}

# Run tests in a subshell to isolate ENV variables
_goss_test() {
  (
    # --- Setup ---
    log "--- Preparing Test Environment ---"
    export PUID=1234 PGID=4321 USER=testuser PASS=Password123 LOG_LEVEL=4
    local volume_name="samba-timemachine_backups"
    local test_file="/backups/permission-test-file"
    local metrics_volume="samba-timemachine_metrics"
    # Every phase mounts a metrics volume; only phase 3 sets METRICS_FILE
    export COMPOSE_FILE="docker-compose.yml:docker-compose.metrics.yml"
    unset METRICS_FILE

    log "Cleaning up previous test runs..."
    docker compose down --volumes --remove-orphans 2>/dev/null || true
    # Both volumes are external, so a failed earlier run can leave them behind
    docker volume rm "${volume_name}" "${metrics_volume}" >/dev/null 2>&1 || true
    docker volume create "${volume_name}" >/dev/null
    docker volume create "${metrics_volume}" >/dev/null

    log "Creating test file with root ownership..."
    docker run --rm -v "${volume_name}:/backups" debian:stable-slim bash -c \
      "touch ${test_file} && chown root:root ${test_file}"

    log "Giving the metrics volume to ${PUID}:${PGID}..."
    docker run --rm -v "${metrics_volume}:/metrics" debian:stable-slim chown "${PUID}:${PGID}" /metrics

    # --- Phase 1: Test with FORCE_PERMISSIONS_RESET=false ---
    log "--- Running Test Phase 1: Default Permissions (No Reset) ---"
    export FORCE_PERMISSIONS_RESET="false"
    _up
    wait_for_health

    log "Running Live Validation..."
    docker compose exec "${CONTAINER_NAME}" \
      "${GOSS_DST}/goss" --gossfile "${GOSS_DST}/tests/goss-live-tests.yaml" validate

    log "Running Healthcheck Validation..."
    docker compose exec "${CONTAINER_NAME}" \
      "${GOSS_DST}/goss" --gossfile "${GOSS_DST}/tests/goss-healthcheck-tests.yaml" validate

    log "Running Permissions Check (Expecting root)..."
    docker compose exec -e EXPECTED_OWNER=root -e EXPECTED_GROUP=root "${CONTAINER_NAME}" \
      "${GOSS_DST}/goss" --gossfile "${GOSS_DST}/tests/goss-permissions-tests.yaml" validate

    log "Running Metrics Disabled Check..."
    docker compose exec "${CONTAINER_NAME}" \
      "${GOSS_DST}/goss" --gossfile "${GOSS_DST}/tests/goss-metrics-disabled-tests.yaml" validate

    log "Phase 1 Passed. Shutting down..."
    _down

    # --- Phase 2: Test with FORCE_PERMISSIONS_RESET=true ---
    log "--- Running Test Phase 2: Forced Permissions Reset ---"
    export FORCE_PERMISSIONS_RESET="true"
    _up
    wait_for_health

    log "Running Permissions Check (Expecting ${USER})..."
    docker compose exec -e EXPECTED_OWNER=${USER} -e EXPECTED_GROUP=${USER} "${CONTAINER_NAME}" \
      "${GOSS_DST}/goss" --gossfile "${GOSS_DST}/tests/goss-permissions-tests.yaml" validate

    log "Phase 2 Passed. Shutting down..."
    _down

    # --- Phase 3: Backup metrics ---
    log "--- Running Test Phase 3: Backup Metrics ---"
    export FORCE_PERMISSIONS_RESET="false"
    export METRICS_FILE="/metrics/timemachine.prom"
    _up
    wait_for_health

    log "Running Metrics Validation..."
    docker compose exec "${CONTAINER_NAME}" \
      "${GOSS_DST}/goss" --gossfile "${GOSS_DST}/tests/goss-metrics-tests.yaml" validate
    _check_metrics_format "empty share"

    local before after
    before=$(_metric_value timemachine_metrics_last_success_timestamp_seconds)
    # Timestamps have one-second resolution
    sleep 1

    # What a Mac leaves in its sparsebundle: the band size, the completed
    # snapshots and the bands themselves
    log "Creating a sparsebundle over SMB from a non-loopback address..."
    docker compose exec -T "${CONTAINER_NAME}" sh -c \
      'dir=$(mktemp -d) &&
      printf "<plist version=\"1.0\">\n<dict>\n\t<key>band-size</key>\n\t<integer>8388608</integer>\n</dict>\n</plist>\n" > "${dir}/Info.plist" &&
      printf "<plist version=\"1.0\">\n<dict>\n\t<key>Snapshots</key>\n\t<array>\n\t\t<dict>\n\t\t\t<date>2026-08-27T18:35:47Z</date>\n\t\t</dict>\n\t\t<dict>\n\t\t\t<date>2026-10-12T10:42:01Z</date>\n\t\t</dict>\n\t</array>\n</dict>\n</plist>\n" > "${dir}/SnapshotHistory.plist" &&
      smbclient //$(hostname -i)/Data -A /run/samba/credentials -I $(hostname -i) -p 10445 \
        -c "mkdir Test-Mac.sparsebundle; mkdir Test-Mac.sparsebundle/bands;
            put /etc/hostname Test-Mac.sparsebundle/bands/0; put /etc/hostname Test-Mac.sparsebundle/bands/1;
            put ${dir}/Info.plist Test-Mac.sparsebundle/Info.plist;
            put ${dir}/SnapshotHistory.plist Test-Mac.sparsebundle/com.apple.TimeMachine.SnapshotHistory.plist"'

    log "Waiting for the disconnect to rewrite the metrics file..."
    for _ in {1..10}; do
      after=$(_metric_value timemachine_metrics_last_success_timestamp_seconds)
      [ "${after:-0}" -gt "${before}" ] && break
      sleep 1
    done
    if [ "${after:-0}" -le "${before}" ]; then
      log "FAIL: last-success time did not move past ${before} after a disconnect"
      exit 1
    fi
    log "Last-success time moved from ${before} to ${after}."

    docker compose exec -T "${CONTAINER_NAME}" cat "${METRICS_FILE}"
    local expected
    for expected in 'timemachine_metrics_success 1' 'timemachine_bundles 1' \
      'timemachine_bundle_last_backup_timestamp_seconds{bundle="Test-Mac"} 1791801721' \
      'timemachine_bundle_size_bytes{bundle="Test-Mac"} 16777216' \
      'timemachine_volume_available_bytes ' 'timemachine_volume_size_bytes '; do
      if ! docker compose exec -T "${CONTAINER_NAME}" cat "${METRICS_FILE}" | grep -qF "${expected}"; then
        log "FAIL: metrics file has no line starting '${expected}'"
        exit 1
      fi
    done
    _check_metrics_format "one bundle"
    _check_dashboard_metrics

    log "Phase 3 Passed."
    log "--- All Tests Passed ---"
  )
  # --- Cleanup ---
  COMPOSE_FILE="docker-compose.yml:docker-compose.metrics.yml" _down
  docker volume rm "samba-timemachine_backups" "samba-timemachine_metrics" >/dev/null
}

_trivy() {
  build
  log "Running Trivy Scan..."
  trivy image \
      --severity HIGH,CRITICAL \
      --ignore-unfixed \
      --exit-code 1 \
      "${IMAGE_NAME}:${IMAGE_TAG}"
}

# --- Release & Deployment ---

copyToTestHost() {
  local TEST_ARCH="amd64"
  log "Building for ${TEST_ARCH} and copying to ${TESTHOST}..."
  
  docker build \
    --build-arg GOSS_IMAGE="${GOSS_IMAGE}:${IMAGE_TAG}" \
    --tag "${IMAGE_NAME}:${TEST_ARCH}" \
    --file Dockerfile .
  
  local size
  size=$(docker image inspect "${IMAGE_NAME}:${TEST_ARCH}" | jq -r '.[0].Size')
  
  docker save "${IMAGE_NAME}:${TEST_ARCH}" | \
    pigz -c | \
    pv -s "${size}" | \
    ssh -C "${TESTHOST}" "pigz -d | docker load"
}

timemachineLogs() {
  local filter='processImagePath contains "backupd" and subsystem beginswith "com.apple.TimeMachine"'
  local start
  start=$(get_start_date)

  echo ""
  echo "[History (from ${start})]"
  echo ""
  log show --style syslog --info --start "${start}" --predicate "${filter}"

  echo ""
  echo "[Following]"
  echo ""
  log stream --style syslog --info --predicate "$filter"
}

release() {
  # clean
  _goss_test
  _trivy

  # Find the latest tag on the current commit
  # We use --exact-match to ensure we are actually ON the tag we are releasing
  if ! CURRENT_TAG=$(git describe --tags --exact-match 2>/dev/null); then
    log "Error: Current commit is not tagged. Please tag the commit before releasing."
    exit 1
  fi
  
  log "Releasing version: ${CURRENT_TAG}"

  # Ensure builder exists
  if ! docker buildx inspect builder >/dev/null 2>&1; then
    docker buildx create --name builder --use
  fi
  
  log "Building and Pushing Multi-arch Image..."
  # Optimization: Build once, tag twice (version + latest), push immediately
  # Uses pushed goss:latest image for multi-arch builds
  docker buildx build \
    --platform "${PLATFORMS}" \
    --build-arg GOSS_IMAGE="${GOSS_IMAGE}:latest" \
    --tag "${IMAGE_NAME}:${CURRENT_TAG}" \
    --tag "${IMAGE_NAME}:latest" \
    --push \
    --file Dockerfile .
    
  log "Release ${CURRENT_TAG} complete."
}

usage() {
  cat <<EOF
Usage: ./run [COMMAND]

Commands:
  build             Build local image (${IMAGE_NAME}:${IMAGE_TAG})
  up                Build and start with docker compose
  down              Stop and remove containers
  exec              Build, start, and shell into container
  test              Run full GOSS test suite (Lifecycle + Healthcheck)
  trivy             Run security scan
  release           Test, Scan, Build Multi-arch, and Push tags to DockerHub
  copyToTestHost    Copy image to ${TESTHOST} via SSH
  timemachineLogs   Stream macOS TimeMachine logs
  clean             Remove images and prune builder
EOF
}

# --- Main Execution ---

CMD=${1:-}
shift || true

case ${CMD} in
    up)              _up ;;
    down)            _down ;;
    exec)            _exec ;;
    build)           build ;;
    clean)           clean ;;
    test)            _goss_test ;;
    trivy)           _trivy ;;
    copyToTestHost)  copyToTestHost ;;
    timemachineLogs) timemachineLogs ;;
    release)         release ;;
    help|--help|-h)  usage ;;
    *)               usage ;;
esac
